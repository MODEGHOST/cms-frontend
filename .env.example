# Leave empty when frontend and backend share the same origin (Vite proxy).
# Production IIS build uses /lfb_cms/backend automatically (see vite/api.js).
# Set only if API is on another origin.
VITE_API_URL=

# SSO: unauthenticated users redirect to LFB Center Portal.
# Local default = http://localhost:5180  Production default = /lfb_center/
VITE_PORTAL_URL=
